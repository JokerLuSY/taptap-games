; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="炎烬之誓"
config/name_localized={
"en": "Oath of Embers"
}
config/description="炎烬之誓：巫女与灰烬 - 回合制战棋 RPG"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

GameLocale="*res://scripts/game_locale.gd"
Audio="*res://scripts/audio.gd"
GameSettings="*res://scripts/game_settings.gd"
CampaignSave="*res://scripts/campaign_save.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[display.android]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://art/theme.tres"

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[internationalization]

locale/fallback="zh_CN"
locale/translations=PackedStringArray("res://locale/ui.zh_CN.translation", "res://locale/ui.en.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
