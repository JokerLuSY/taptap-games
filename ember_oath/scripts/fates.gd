## 第 ch 章（从 1 数）倒下：撤退（true）还是阵亡（false）
static func retreats(id: String, ch: int) -> bool:
	return ch > 0 and ch <= int(STORY_UNTIL.get(id, 0))


static func last_words(id: String, retreat: bool) -> String:
	if retreat:
		return str(RETREAT.get(id, "……我撤退了。"))
	return str(DEATH.get(id, ""))
