## 一对的 key（不分前后）
static func key_of(a: String, b: String) -> String:
	if PAIRS.has(a + "|" + b):
		return a + "|" + b
	if PAIRS.has(b + "|" + a):
		return b + "|" + a
	return ""


## 这对已到的等级（"" = 还没有支援）
static func rank_of(u, partner_id: String) -> String:
	return str(u.support_with.get(partner_id, ""))


## 下一档等级（已 A 返回 ""）
static func next_rank(cur: String) -> String:
	if cur == "":
		return "C"
	var i := ORDER.find(cur)
	return ORDER[i + 1] if i >= 0 and i + 1 < ORDER.size() else ""


static func need_points(key: String, rank: String) -> int:
	return int(PAIRS.get(key, {}).get(rank, 9999))


## 战斗加成：3 格内每个已支援伙伴按等级叠加
static func bonus(u, units: Array) -> Dictionary:
	var out := {"hit": 0, "avo": 0, "crit": 0}
	if u.support_with.is_empty():
		return out
	for v in units:
		if v == u or not v.on_map() or v.is_player() != u.is_player():
			continue
		var r := str(u.support_with.get(v.unit_id, ""))
		if r == "" or GameData.dist(u.grid_pos, v.grid_pos) > RANGE:
			continue
		var b: Dictionary = BONUS.get(r, {})
		for k in out:
			out[k] += int(b.get(k, 0))
	return out


static func lines(key: String, rank: String) -> Array:
	var out: Array = []
	for pair in TALKS.get(key, {}).get(rank, []):
		var who: String = pair[0]
		out.append({"name": who, "color": COLORS.get(who, Color(0.9, 0.9, 0.9)), "text": TranslationServer.translate(pair[1])})
	return out
